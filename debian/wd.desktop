[Desktop Entry]
Type=Application
Name=wd
GenericName=Word Lookup Daemon
Comment=Lightweight word lookup daemon and popup dictionary
Exec=/usr/bin/wd --daemon
Terminal=false
Categories=Utility;Accessibility;
StartupNotify=false
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=1
X-KDE-autostart-after=panel
NoDisplay=true
